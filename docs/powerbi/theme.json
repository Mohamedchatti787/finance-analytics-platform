{
  "name": "Meridian Finance",
  "dataColors": ["#1F6FEB", "#2A9D8F", "#F4A261", "#D1495B", "#8AB17D", "#9AA4B2", "#6C5CE7", "#E9C46A", "#264653", "#B56576"],
  "background": "#FFFFFF",
  "foreground": "#1F2933",
  "tableAccent": "#1F6FEB",
  "good": "#2A9D8F",
  "neutral": "#E9C46A",
  "bad": "#D1495B",
  "maximum": "#1F6FEB",
  "center": "#E9C46A",
  "minimum": "#D1495B",
  "null": "#9AA4B2",
  "textClasses": {
    "title":   { "fontFace": "Segoe UI Semibold", "fontSize": 14, "color": "#1F2933" },
    "label":   { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52606D" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 28, "color": "#1F2933" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "border": [{ "show": false }],
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1F2933" } }, "fontSize": 12 }]
      }
    },
    "page": {
      "*": { "background": [{ "color": { "solid": { "color": "#F4F6F8" } }, "transparency": 0 }] }
    }
  }
}
